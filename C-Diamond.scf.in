&CONTROL
    calculation = 'scf'
    prefix = 'diamond'
    outdir = './tmp'
    pseudo_dir = './'
    tstress = .true.
    tprnfor = .true.
/

&SYSTEM
    ibrav = 2
    celldm(1) = 6.7465
    nat = 2
    ntyp = 1
    ecutwfc = 60
    ecutrho = 480
/

&ELECTRONS
    conv_thr = 1.0d-10
    mixing_beta = 0.7
/

ATOMIC_SPECIES
    C 12.0107 C.pbe-n-rrkjus_psl.1.0.0.UPF

ATOMIC_POSITIONS crystal
    C 0.00 0.00 0.00
    C 0.25 0.25 0.25

K_POINTS automatic
    8 8 8 0 0 0